\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Making a Request\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Responding to a Request\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Could you \u2026?<br> Can you \u2026?<br> Would you mind \u2026?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Sure. No problem.<br> I'd love to.<br> Yes, no problem.<br>  <br>Sorry, I can't.</br> I'm sorry, I can't.<br></span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "<span class = \"strong\">Peter</span>: Could I borrow your phone?<br/> <span class = \"strong\">Jenny</span>: Yes, no problem!", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "You're the best.", "type": "name"}, {"content": "use this to tell someone you appreciate them", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: <span class=\"strong\">Anna</span>: I can look after your cat.  <span class=\"strong\">Ben</span>: You're the best.", "type": "example"}, {"content": "engenn3le04ob10aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you hear in conversations between friends.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to travel the world", "type": "name"}, {"content": "to travel to many different countries", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I want to travel the world.", "type": "example"}, {"content": "engenn3le04ob10aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "suitcase ", "type": "name"}, {"content": "a large bag to put your clothes in when you travel ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I have to buy a new suitcase for my trip.", "type": "example"}, {"content": "engenn3le04ob10aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "away ", "type": "name"}, {"content": "to be out of town", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Can you look after my cat when I'm away?", "type": "example"}, {"content": "engenn3le04ob10aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to look after ", "type": "name"}, {"content": "to take care of someone or something", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Can you look after my cat?", "type": "example"}, {"content": "engenn3le04ob10aud05", "type": "audio"}]}, {"content": "engenn3le04ob10re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Imagine you are going on a vacation.", "type": "text"}, {"content": "Write a short dialogue making requests to your friend. (For example: <span class=\"italic\">Can you look after my cat? dog? plants?</span>)", "type": "text"}, {"content": "Practice the dialogue with your partner.", "type": "text"}, {"content": "Switch roles and practice again.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I make and respond to requests.", "type": "text"}, {"content": "I show interest and surprise.", "type": "text"}, {"content": "I write a short dialogue.", "type": "text"}]}], "type": "sena"}